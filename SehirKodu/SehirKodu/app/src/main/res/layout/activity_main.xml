<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/anaLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="İl Kodları (Doğru)"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:textSize="15sp"
        android:layout_marginBottom="4dp"/>

    <ListView
        android:id="@+id/lvDogru"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Karışık Kodlar (Bir il seçin)"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:textSize="15sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <ListView
        android:id="@+id/lvKarisik"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice" />

    <Button
        android:id="@+id/btnSorgula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Sorgula"
        android:backgroundTint="#2980B9"
        android:textColor="#FFFFFF" />

</LinearLayout>
