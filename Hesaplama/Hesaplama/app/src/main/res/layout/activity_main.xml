<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/anaEkran"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvSonuc"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="24dp"
        android:background="#16213E"
        android:gravity="end|center_vertical"
        android:padding="16dp"
        android:textColor="#E0E0E0"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:columnCount="4"
        android:rowCount="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSonuc">

        <!-- Satır 0 -->
        <Button android:id="@+id/rakam7"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="7" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/rakam8"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="8" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/rakam9"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="9" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/islemBol"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#E94560"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="/" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <!-- Satır 1 -->
        <Button android:id="@+id/rakam4"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="4" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/rakam5"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="5" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/rakam6"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="6" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/islemCarp"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#E94560"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="x" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <!-- Satır 2 -->
        <Button android:id="@+id/rakam1"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="1" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/rakam2"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="2" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/rakam3"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="3" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/islemCikar"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#E94560"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="-" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <!-- Satır 3 -->
        <Button android:id="@+id/rakam0"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#0F3460"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="0" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/btnTemizle"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#533483"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="C" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/btnEsit"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#533483"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="=" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

        <Button android:id="@+id/islemTopla"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_margin="8dp"
            android:backgroundTint="#E94560"
            android:insetBottom="0dp" android:insetLeft="0dp"
            android:insetRight="0dp" android:insetTop="0dp"
            android:text="+" android:textColor="#FFFFFF" android:textSize="24sp"
            app:cornerRadius="36dp" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
